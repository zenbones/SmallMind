<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <bean id="rabbitMQConnectorFactory" class="org.smallmind.phalanx.wire.transport.amqp.rabbitmq.spring.RabbitMQConnectorFactoryBean">
    <property name="username" value="${rabbitmq.username}"/>
    <property name="password" value="${rabbitmq.password}"/>
    <property name="heartbeatSeconds" value="5"/>
  </bean>

  <!--
    A null perApplicationScope adopts the scope bound on the thread refreshing this context: under the Tanuki
    wrapper (SpringContextWrapperListener) or PerApplicationScopeContextLoaderListener, the application's scope,
    so the transport threads are bound to the same scope the refresh ran in. With no scope bound on that thread
    the transport threads run with no scope. To hand in a specific instance instead, replace <null/> with a ref,
    for example to the org.smallmind.spark.perApplicationScope singleton the wrapper registers; a ref to any
    instance other than the bound one fails the refresh with ScopeException.
  -->
  <bean id="nameConfiguration" class="org.smallmind.phalanx.wire.transport.amqp.rabbitmq.NameConfiguration"/>

  <bean id="jsonSignalCodec" class="org.smallmind.phalanx.wire.signal.JsonSignalCodec">
    <property name="verbose" value="true"/>
    <property name="verboseLogLevel" value="DEBUG"/>
  </bean>

  <bean id="rabbitmqRequestTransport" class="org.smallmind.phalanx.wire.transport.amqp.rabbitmq.RabbitMQRequestTransport" destroy-method="close">
    <constructor-arg index="0" name="rabbitMQConnector" ref="rabbitMQConnectorFactory"/>
    <constructor-arg index="1" name="nameConfiguration" ref="nameConfiguration"/>
    <constructor-arg index="2" name="signalCodec" ref="jsonSignalCodec"/>
    <constructor-arg index="3" name="clusterSize" value="${wire.cluster_size}"/>
    <constructor-arg index="4" name="concurrencyLimit" value="${wire.concurrency_limit}"/>
    <constructor-arg index="5" name="defaultTimeoutSeconds" value="${wire.default_timeout_seconds}"/>
    <constructor-arg index="6" name="messageTTLSeconds" value="${wire.message_ttl_seconds}"/>
    <constructor-arg index="7" name="autoAcknowledge" value="false"/>
    <constructor-arg index="8" name="publisherConfirmationHandler">
      <null/>
    </constructor-arg>
    <constructor-arg index="9" name="perApplicationScope"><null/></constructor-arg>
  </bean>

  <bean id="rabbitmqResponseTransport" class="org.smallmind.phalanx.wire.transport.amqp.rabbitmq.RabbitMQResponseTransport" destroy-method="close">
    <constructor-arg index="0" name="rabbitMQConnector" ref="rabbitMQConnectorFactory"/>
    <constructor-arg index="1" name="nameConfiguration" ref="nameConfiguration"/>
    <constructor-arg index="2" name="workerClass" value="org.smallmind.phalanx.wire.transport.amqp.rabbitmq.InvocationWorker"/>
    <constructor-arg index="3" name="signalCodec" ref="jsonSignalCodec"/>
    <constructor-arg index="4" name="serviceGroup" value="default"/>
    <constructor-arg index="5" name="clusterSize" value="${wire.cluster_size}"/>
    <constructor-arg index="6" name="concurrencyLimit" value="${wire.concurrency_limit}"/>
    <constructor-arg index="7" name="messageTTLSeconds" value="${wire.message_ttl_seconds}"/>
    <constructor-arg index="8" name="quorumReplicationCount" value="3"/>
    <constructor-arg index="9" name="autoAcknowledge" value="false"/>
    <constructor-arg index="10" name="publisherConfirmationHandler">
      <null/>
    </constructor-arg>
    <constructor-arg index="11" name="perApplicationScope"><null/></constructor-arg>
  </bean>

  <bean id="kafkaRequestTransport" class="org.smallmind.phalanx.wire.transport.kafka.KafkaRequestTransport" destroy-method="close">
    <constructor-arg index="0" name="nodeName" value="guid/host/pod"/>
    <constructor-arg index="1" name="signalCodec" ref="jsonSignalCodec"/>
    <constructor-arg index="2" name="concurrencyLimit" value="${wire.concurrency_limit}"/>
    <constructor-arg index="3" name="defaultTimeoutSeconds" value="${wire.default_timeout_seconds}"/>
    <constructor-arg index="4" name="startupGracePeriodSeconds" value="10"/>
    <constructor-arg index="5" name="groupProtocol" value="CONSUMER"/>
    <constructor-arg index="6" name="dynamicConsumers" value="true"/>
    <constructor-arg index="7" name="perApplicationScope"><null/></constructor-arg>
    <constructor-arg index="8" name="servers">
      <bean class="org.smallmind.kafka.utility.KafkaServerFactoryBean">
        <property name="serverPattern" value="localhost:9094"/>
        <property name="serverSpread" value=""/>
      </bean>
    </constructor-arg>
  </bean>

  <bean id="kafkaResponseTransport" class="org.smallmind.phalanx.wire.transport.kafka.KafkaResponseTransport" destroy-method="close">
    <constructor-arg index="0" name="nodeName" value="guid/host/pod"/>
    <constructor-arg index="1" name="serviceGroup" value="default"/>
    <constructor-arg index="2" name="workerClass" value="org.smallmind.phalanx.wire.transport.kafka.InvocationWorker"/>
    <constructor-arg index="3" name="signalCodec" ref="jsonSignalCodec"/>
    <constructor-arg index="4" name="concurrencyLimit" value="${wire.concurrency_limit}"/>
    <constructor-arg index="5" name="startupGracePeriodSeconds" value="10"/>
    <constructor-arg index="6" name="groupProtocol" value="CONSUMER"/>
    <constructor-arg index="7" name="dynamicConsumers" value="true"/>
    <constructor-arg index="8" name="perApplicationScope"><null/></constructor-arg>
    <constructor-arg index="9" name="servers">
      <bean class="org.smallmind.kafka.utility.KafkaServerFactoryBean">
        <property name="serverPattern" value="localhost:9094"/>
        <property name="serverSpread" value=""/>
      </bean>
    </constructor-arg>
  </bean>
</beans>
